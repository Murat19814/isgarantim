# ─────────────────────────────────────────────
# isgarantim.com / İşKalkan - Ortam Değişkenleri
# Bu dosyayı ".env" olarak kopyalayıp değerleri doldur.
# ─────────────────────────────────────────────

# PostgreSQL bağlantısı
# Yerel örnek: postgresql://postgres:postgres@localhost:5432/isgarantim?schema=public
# Neon (havuzlu/pooler) — uygulama çalışma zamanı:
DATABASE_URL="postgresql://KULLANICI:SIFRE@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Neon (doğrudan/pooler'sız) — Prisma migration için (host'tan "-pooler" kaldırılmış hali):
DIRECT_URL="postgresql://KULLANICI:SIFRE@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="degistir-bunu-uzun-rastgele-bir-deger"

# E-posta doğrulama (SMTP) - Faz 2
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="İşKalkan <no-reply@isgarantim.com>"

# SMS / Telefon doğrulama (ör. Netgsm / Twilio) - Faz 2
SMS_PROVIDER="netgsm"
SMS_API_KEY=""
SMS_API_SECRET=""
SMS_SENDER="ISGARANTIM"

# Ödeme / Pazaryeri emanet (ör. iyzico Marketplace / PayTR) - Faz 4
PAYMENT_PROVIDER="iyzico"
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# Dosya yükleme (Cloudinary / S3) - Faz 3
UPLOAD_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Kontör / kredi ayarları
DEFAULT_OFFER_CREDIT_COST="100"
